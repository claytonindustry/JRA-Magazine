{
  "rules": {
    ".read": false,
    ".write": false,
    "library": {
      ".read": true,
      ".write": "auth != null && root.child('people').child(auth.token.email.toLowerCase().replace('.', ',')).child('role').val() === 'owner'"
    },
    "issues": {
      ".read": true,
      ".write": "auth != null && root.child('people').child(auth.token.email.toLowerCase().replace('.', ',')).child('role').val() === 'owner'"
    },
    "searchindex": {
      ".read": true,
      ".write": "auth != null && root.child('people').child(auth.token.email.toLowerCase().replace('.', ',')).child('role').val() === 'owner'"
    },
    "site": {
      ".read": true,
      ".write": "auth != null && root.child('people').child(auth.token.email.toLowerCase().replace('.', ',')).child('role').val() === 'owner'"
    },
    "gallery": {
      ".read": true,
      ".write": "auth != null && root.child('people').child(auth.token.email.toLowerCase().replace('.', ',')).child('role').val() === 'owner'"
    },
    "articles": {
      ".read": "auth != null && root.child('people').child(auth.token.email.toLowerCase().replace('.', ',')).exists()",
      "$article": {
        ".write": "auth != null && root.child('people').child(auth.token.email.toLowerCase().replace('.', ',')).child('role').val() === 'owner' || (auth != null && root.child('people').child(auth.token.email.toLowerCase().replace('.', ',')).exists() && newData.exists())"
      }
    },
    "magazines": {
      ".read": "auth != null && root.child('people').child(auth.token.email.toLowerCase().replace('.', ',')).exists()",
      "$magazine": {
        ".write": "auth != null && root.child('people').child(auth.token.email.toLowerCase().replace('.', ',')).child('role').val() === 'owner' || (auth != null && root.child('people').child(auth.token.email.toLowerCase().replace('.', ',')).exists() && data.exists() && newData.exists())"
      }
    },
    "images": {
      ".read": "auth != null && root.child('people').child(auth.token.email.toLowerCase().replace('.', ',')).exists()",
      "$image": {
        ".write": "auth != null && root.child('people').child(auth.token.email.toLowerCase().replace('.', ',')).child('role').val() === 'owner' || (auth != null && root.child('people').child(auth.token.email.toLowerCase().replace('.', ',')).exists() && newData.exists())"
      }
    },
    "icons": {
      ".read": "auth != null && root.child('people').child(auth.token.email.toLowerCase().replace('.', ',')).exists()",
      ".write": "auth != null && root.child('people').child(auth.token.email.toLowerCase().replace('.', ',')).exists()"
    },
    "pages": {
      ".read": "auth != null && root.child('people').child(auth.token.email.toLowerCase().replace('.', ',')).exists()",
      ".write": "auth != null && root.child('people').child(auth.token.email.toLowerCase().replace('.', ',')).exists()"
    },
    "chat": {
      ".read": "auth != null && root.child('people').child(auth.token.email.toLowerCase().replace('.', ',')).exists()",
      "said": {
        "$said": {
          ".write": "auth != null && root.child('people').child(auth.token.email.toLowerCase().replace('.', ',')).exists()",
          ".validate": "newData.hasChildren(['by', 'text', 'at'])",
          "by": {
            ".validate": "newData.isString() && newData.val().length < 200"
          },
          "name": {
            ".validate": "newData.isString() && newData.val().length < 120"
          },
          "text": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 2000"
          },
          "at": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "here": {
        "$person": {
          ".write": "auth != null && root.child('people').child(auth.token.email.toLowerCase().replace('.', ',')).exists() && $person === auth.token.email.toLowerCase().replace('.', ',')",
          ".validate": "newData.hasChildren(['at'])",
          "name": {
            ".validate": "newData.isString() && newData.val().length < 120"
          },
          "at": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "people": {
      ".read": "auth != null && root.child('people').child(auth.token.email.toLowerCase().replace('.', ',')).exists()",
      "$person": {
        ".read": "auth != null && $person === auth.token.email.toLowerCase().replace('.', ',')",
        ".write": "auth != null && root.child('people').child(auth.token.email.toLowerCase().replace('.', ',')).child('role').val() === 'owner'",
        ".validate": "newData.hasChildren(['name', 'role'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length < 120"
        },
        "role": {
          ".validate": "newData.isString() && (newData.val() === 'owner' || newData.val() === 'editor')"
        },
        "added": {
          ".validate": "newData.isNumber()"
        },
        "addedBy": {
          ".validate": "newData.isString() && newData.val().length < 200"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "admins": {
      ".read": false,
      ".write": false
    }
  }
}
