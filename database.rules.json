{
  "rules": {
    ".read": false,
    ".write": false,
    "library": {
      ".read": true,
      ".write": "auth != null && root.child('people').child(auth.uid).exists()"
    },
    "issues": {
      ".read": true,
      ".write": "auth != null && root.child('people').child(auth.uid).exists()"
    },
    "searchindex": {
      ".read": true,
      ".write": "auth != null && root.child('people').child(auth.uid).exists()"
    },
    "site": {
      ".read": true,
      ".write": "auth != null && root.child('people').child(auth.uid).exists()"
    },
    "gallery": {
      ".read": true,
      ".write": "auth != null && root.child('people').child(auth.uid).exists()"
    },
    "articles": {
      ".read": "auth != null && root.child('people').child(auth.uid).exists()",
      ".write": "auth != null && root.child('people').child(auth.uid).exists()"
    },
    "magazines": {
      ".read": "auth != null && root.child('people').child(auth.uid).exists()",
      ".write": "auth != null && root.child('people').child(auth.uid).exists()"
    },
    "images": {
      ".read": "auth != null && root.child('people').child(auth.uid).exists()",
      ".write": "auth != null && root.child('people').child(auth.uid).exists()"
    },
    "icons": {
      ".read": "auth != null && root.child('people').child(auth.uid).exists()",
      ".write": "auth != null && root.child('people').child(auth.uid).exists()"
    },
    "pages": {
      ".read": "auth != null && root.child('people').child(auth.uid).exists()",
      ".write": "auth != null && root.child('people').child(auth.uid).exists()"
    },
    "people": {
      ".read": "auth != null",
      "$person": {
        ".write": "auth != null && root.child('people').child(auth.uid).child('role').val() === 'owner'",
        ".validate": "newData.hasChildren(['name', 'role'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length < 120"
        },
        "email": {
          ".validate": "newData.isString() && newData.val().length < 200"
        },
        "role": {
          ".validate": "newData.isString() && (newData.val() === 'owner' || newData.val() === 'editor')"
        },
        "added": {
          ".validate": "newData.isNumber()"
        },
        "addedBy": {
          ".validate": "newData.isString() && newData.val().length < 200"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "admins": {
      ".read": false,
      ".write": false
    }
  }
}
